<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Receipt</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen p-3 sm:p-4 md:p-10 text-slate-700">
    <div class="max-w-3xl mx-auto bg-white shadow-xl ring-1 ring-slate-200 rounded-2xl overflow-hidden">
        <div class="h-1.5 bg-indigo-700"></div>
        <div class="p-3 sm:p-6 md:p-8 text-xs sm:text-sm md:text-base">
            <p class="text-indigo-800 text-xs sm:text-sm font-semibold">Transaction Amount</p>
            <h1 class="mt-1 text-2xl sm:text-4xl font-bold text-slate-900 leading-tight">
                <%
                    const formattedAmount = new Intl.NumberFormat('en-US', {
                        style: 'decimal',
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }).format(amount);
                %>
                <% if (paymentType === 'swift_euro') { %>
                    EUR <%= formattedAmount %>
                <% } else if (paymentType === 'faster_payment_gbp') { %>
                    GBP <%= formattedAmount %>
                <% } else { %>
                    USD <%= formattedAmount %>
                <% } %>
            </h1>

            <% 
                const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
                function formatDateTime(dt, includeTime) {
                    const d = dt ? new Date(dt) : new Date();
                    const day = d.getDate();
                    const month = months[d.getMonth()];
                    const year = d.getFullYear();
                    if (!includeTime) {
                        return `${day} ${month} ${year}`;
                    }
                    let hours = d.getHours();
                    const minutes = String(d.getMinutes()).padStart(2, '0');
                    const ampm = hours >= 12 ? 'pm' : 'am';
                    hours = hours % 12 || 12;
                    return `${day} ${month} ${year} at ${hours}:${minutes} ${ampm}`;
                }
                const includeTime = !!details.showTime;
            %>

            <%
                const isSwift = paymentType === 'swift_usd' || paymentType === 'swift_euro';
                const swiftCurrency = paymentType === 'swift_euro' ? 'EUR' : 'USD';
                function swiftDate(dt) {
                    const d = dt ? new Date(dt) : new Date();
                    const yy = String(d.getFullYear()).slice(-2);
                    const mm = String(d.getMonth() + 1).padStart(2, '0');
                    const dd = String(d.getDate()).padStart(2, '0');
                    return `${yy}${mm}${dd}`;
                }
                const swiftAmount = new Intl.NumberFormat('en-US', {
                    style: 'decimal',
                    useGrouping: false,
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(amount).replace('.', ',');
                const accountLine50 = details.senderAccountNumber && details.senderAccountNumber.trim() ? '/' + details.senderAccountNumber.trim() : '';
                const accountLine59 = (details.iban || details.accountNumber) ? '/' + (details.iban || details.accountNumber).trim() : '';
                const swiftRows = [
                    [':20:', "Sender's Reference", details.referenceNumber && details.referenceNumber.trim()],
                    [':23B:', 'Bank Operation Code', 'CRED'],
                    [':32A:', 'Value Date/Currency/Amount', `${swiftDate(details.transactionDateTime)}${swiftCurrency}${swiftAmount}`],
                    [':50:', 'Ordering Customer', [accountLine50, details.senderName].filter(Boolean).join('\n')],
                    [':57:', 'Account With Institution', [details.bankName, details.bic].filter(Boolean).join('\n')],
                    [':59:', 'Beneficiary Customer', [accountLine59, details.recipientName].filter(Boolean).join('\n')],
                    [':70:', 'Remittance Information', details.transferNote && details.transferNote.trim()],
                ].filter(function(row) { return row[2]; });
                const swiftMetaRows = [
                    ['Transaction Type', details.transactionType || 'Transfer'],
                    ['Payment Method', details.paymentMethod || 'SWIFT'],
                    ['Country', details.country],
                ].filter(function(row) { return row[1]; });
            %>

            <div class="mt-5 sm:mt-8 border border-slate-200 rounded-2xl overflow-hidden">
                <% if (isSwift) { %>
                    <div class="px-3 sm:px-4 md:px-6 py-3 bg-slate-900 font-mono text-[11px] sm:text-sm text-white tracking-widest uppercase">
                        SWIFT MT103 &mdash; Customer Transfer
                    </div>
                    <% swiftRows.forEach(function(row) { %>
                        <div class="flex gap-2 sm:gap-4 px-3 sm:px-4 md:px-6 py-2.5 sm:py-3 border-b border-slate-200 font-mono text-[11px] sm:text-sm">
                            <span class="w-10 sm:w-14 shrink-0 font-bold text-indigo-800"><%= row[0] %></span>
                            <span class="hidden sm:block w-48 shrink-0 text-slate-500 uppercase"><%= row[1] %></span>
                            <span class="flex-1 text-slate-800 font-semibold break-all whitespace-pre-line"><%= row[2] %></span>
                        </div>
                    <% }) %>
                    <% swiftMetaRows.forEach(function(row) { %>
                        <div class="grid grid-cols-2 gap-2 sm:gap-4 px-3 sm:px-4 md:px-6 py-2.5 sm:py-3 border-b border-slate-200">
                            <p class="text-slate-700 font-medium"><%= row[0] %></p>
                            <p class="text-right text-slate-600 font-semibold break-all"><%= row[1] %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                <% const rowEntries = [
                    ['Transaction Type', details.transactionType || 'Transfer'],
                    ['Recipient Name', details.recipientName || '-'],
                    // Only include Sender Name if it exists in details
                    ...(details.senderName ? [['Sender Name', details.senderName]] : []),
                    ...(details.referenceNumber && details.referenceNumber.trim() ? [['Reference Number', details.referenceNumber.trim()]] : []),
                    ['Payment Method', details.paymentMethod || '-'],
                    ['Bank Name', details.bankName],
                    ['Account Number', details.accountNumber],
                    ['Routing Number', details.routingNumber],
                    ['Sort Code', details.sortCode],
                    ['IBAN', details.iban],
                    ['BIC / SWIFT', details.bic],
                    ['Country', details.country],
                    ['Transfer Note', details.transferNote],
                    [includeTime ? 'Transaction Date & Time' : 'Transaction Date', formatDateTime(details.transactionDateTime, includeTime)],
                ].filter((item) => item[1]); %>

                <% rowEntries.forEach(function(item) { %>
                    <div class="grid grid-cols-2 gap-2 sm:gap-4 px-3 sm:px-4 md:px-6 py-2.5 sm:py-4 border-b border-slate-200">
                        <p class="text-slate-700 font-medium"><%= item[0] %></p>
                        <p class="text-right text-slate-600 font-semibold break-all"><%= item[1] %></p>
                    </div>
                <% }) %>
                <% } %>
                <% if (details.status) { %>
                    <div class="grid grid-cols-2 gap-2 sm:gap-4 px-3 sm:px-4 md:px-6 py-2.5 sm:py-4">
                        <p class="text-slate-700 font-medium">Status</p>
                        <p class="text-right">
                            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold <%= details.status === 'Settled' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                                <%= details.status %>
                            </span>
                        </p>
                    </div>
                <% } %>
            </div>

            <div class="mt-6 flex gap-3 justify-end print:hidden">
                <a href="/dashboard" class="rounded-lg border border-slate-300 px-4 py-2 text-slate-700 hover:bg-slate-50 text-center">Back</a>
                <button onclick="window.print()" class="rounded-lg bg-slate-900 text-white px-4 py-2 hover:bg-slate-800">Print</button>
            </div>
        </div>
    </div>
</body>
</html>